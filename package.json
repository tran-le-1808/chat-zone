{
  "name": "chat-zone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:mono-anim": "node --import ./app/games/pool/_tests/register.mjs --test app/games/monopoly/_components/board/anim/_tests/*.test.ts",
    "test:mono-bot": "node --import ./app/games/pool/_tests/register.mjs --test app/games/monopoly/_lib/_tests/*.test.ts",
    "test:pool": "node --import ./app/games/pool/_tests/register.mjs --test app/games/pool/_tests/*.test.ts",
    "pool:sync-shared": "node scripts/sync-pool-shared.mjs",
    "pool:pocket-map": "node --import ./app/games/pool/_tests/register.mjs app/games/pool/_tests/pocket-map.ts",
    "test:prison": "node --import ./app/games/prison/_tests/register.mjs --test app/games/prison/_tests/*.test.ts",
    "test:caro": "node --import ./app/games/pool/_tests/register.mjs --test app/games/caro/_tests/*.test.ts",
    "caro:sync-shared": "mkdir -p ../login-system/src/caro/shared && cp app/games/caro/_lib/rules.ts app/games/caro/_lib/engine/book.ts ../login-system/src/caro/shared/ && cd ../login-system && npx prettier --write src/caro/shared/*.ts",
    "test:billiard": "node --import ./app/games/pool/_tests/register.mjs --test app/games/billiard/_tests/*.test.ts",
    "prison:sync-shared": "node scripts/sync-prison-shared.mjs",
    "test:xiangqi": "node --import ./app/games/pool/_tests/register.mjs --test app/games/xiangqi/_tests/*.test.ts",
    "test:chess": "node --import ./app/games/pool/_tests/register.mjs --test app/games/chess/_tests/*.test.ts",
    "chess:sync-shared": "mkdir -p ../login-system/src/chess/shared && cp app/games/chess/_lib/rules.ts ../login-system/src/chess/shared/ && cd ../login-system && npx prettier --write src/chess/shared/*.ts",
    "xiangqi:sync-shared": "mkdir -p ../login-system/src/xiangqi/shared && cp app/games/xiangqi/_lib/rules.ts ../login-system/src/xiangqi/shared/ && cd ../login-system && npx prettier --write src/xiangqi/shared/*.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "three": "^0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
